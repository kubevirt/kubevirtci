#!/bin/bash
set -e

# Configure the secondary network interfaces of a node.
#
# This script is rendered from a template, with the interfaces to act on baked
# in by the caller. Nothing here discovers interfaces on its own, so a node
# only ever gets the configuration that was asked for.
#
# Uses NetworkManager (nmcli) to create persistent configurations.

# Enslave an interface to a bridge of its own, brX for ethX.
setup_bridge() {
    local iface="$1"
    local bridge_name="br${iface#eth}"

    echo "Setting up bridge ${bridge_name} for interface ${iface}"

    # Delete existing connections for the interface if any (to ensure clean state)
    nmcli connection delete ${iface} 2>/dev/null || true
    nmcli connection delete ${bridge_name} 2>/dev/null || true

    # Create bridge connection (disable DHCP to avoid timeouts)
    nmcli connection add type bridge ifname ${bridge_name} con-name ${bridge_name} \
      bridge.stp no ipv4.method disabled ipv6.method disabled

    # Add ethernet interface as bridge slave
    nmcli connection add type ethernet ifname ${iface} con-name ${iface} master ${bridge_name}

    # Bring up the bridge (which will also bring up the slave)
    nmcli connection up ${bridge_name}

    echo "Bridge ${bridge_name} created and configured successfully"
}

# Give an interface an address of its own instead of a bridge.
configure_static_ip() {
    local iface="$1"
    local iface_ipv4="$2"
    local iface_ipv6="$3"

    echo "Setting up interface ${iface} with ${iface_ipv4} ${iface_ipv6}"

    # Delete existing connection for the interface if any (to ensure clean state)
    nmcli connection delete ${iface} 2>/dev/null || true

    # The connected routes come with the addresses, and never-default keeps a
    # secondary interface from stealing eth0's default route.
    nmcli connection add type ethernet ifname ${iface} con-name ${iface} \
      ipv4.method manual ipv4.addresses "${iface_ipv4}" ipv4.never-default yes \
      ipv6.method manual ipv6.addresses "${iface_ipv6}" ipv6.never-default yes

    nmcli connection up ${iface}

    echo "Interface ${iface} configured successfully"
}
{{range .BridgedIfaces}}
setup_bridge {{.}}
{{- end}}
{{- range .AddressedIfaces}}
configure_static_ip {{.Name}} {{.IPv4}} {{.IPv6}}
{{- end}}

echo "All secondary interfaces configured"
